# ----------------------------------------------------------------------------
# Identifiants espace-citoyens.net
# Créez votre compte sur https://www.espace-citoyens.net puis renseignez ici
# votre identifiant et mot de passe. NE PUBLIEZ JAMAIS CE FICHIER (déjà dans
# .gitignore).
# ----------------------------------------------------------------------------

ESPACE_CITOYENS_USERNAME=votre_identifiant
ESPACE_CITOYENS_PASSWORD=votre_mot_de_passe

# Obligatoire — URL du portail de votre commune
ESPACE_CITOYENS_BASE_URL=https://www.espace-citoyens.net/maville/espace-citoyens

# Optionnel — ID dynamique de la personne (défaut : 4)
# ESPACE_CITOYENS_PERSON_ID=4

# Optionnel — Répertoire de sortie (défaut : ./data)
# GUICHET_OUTPUT_DIR=./data

# Optionnel — URL publique exposée derrière votre reverse proxy (Nginx Proxy
# Manager, Traefik, …). Sert à générer les liens d'abonnement iCal affichés
# dans la WebUI (Settings → Intégration). Défaut : vide (liens relatifs)
# GUICHET_PUBLIC_URL=https://guichet.example.com

# ----------------------------------------------------------------------------
# Home Assistant — agenda cible (dev local ; dans l'add-on, seule l'option
# calendar_entity est à renseigner, le jeton est fourni par le Supervisor).
# ----------------------------------------------------------------------------
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=<jeton longue durée>
# HA_CALENDAR_ENTITY=calendar.agenda_enfant
# GUICHET_DEFAULT_LOCATION=Adresse de l'école

# Optionnel — entités HA via MQTT discovery (cantine aujourd'hui/demain, coûts…)
# MQTT_HOST=core-mosquitto
# MQTT_PORT=1883
# MQTT_USERNAME=...
# MQTT_PASSWORD=...

# ----------------------------------------------------------------------------
# Authentification HTTP Basic (WebUI derrière un proxy / exposé sur Internet)
# - Quand ces variables ne sont pas définies, le conteneur génère un couple
#   aléatoire au démarrage et le logue dans `docker logs guichet-unique`.
# - Les accès LAN (réseaux 10/8, 172.16/12, 192.168/16, 127/8) ne demandent
#   JAMAIS d'authentification (détection via X-Forwarded-For + client.host).
# - L'accès via `https://guichet.example.com` (Internet via NPM) exige ce couple.
# - Le flux `/ical/<token>` reste public pour Google/Apple/DAVx5.
# ----------------------------------------------------------------------------
# GUICHET_BASIC_USER=admin
# GUICHET_BASIC_PASS=un-mot-de-passe-tres-long-ici
